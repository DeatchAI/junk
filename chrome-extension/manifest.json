{
  "manifest_version": 3,
  "name": "Detach Browser Agent",
  "description": "Lets Detach agents inspect and act on the current Chrome tab with user-approved access.",
  "version": "0.1.2",
  "key": "",
  "action": {
    "default_title": "Detach Browser Agent",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:3847 ws://localhost:3847"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
