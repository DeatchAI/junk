# Optional integration. Leave blank unless you use Composio.
COMPOSIO_API_KEY=

# Local development overrides.
PORT=3847
# DETACH_DATA_DIR=/absolute/path/for/development-data

# Hosted builds receive these from the signed macOS app. Never put a Vercel or
# Kie provider key in this local runtime.
# DETACH_DISTRIBUTION_MODE=hosted
# DETACH_HOSTED_CONTROL_PLANE_URL=https://detach.run
# DETACH_OPENCODE_PATH=/absolute/path/to/opencode
# DETACH_OPENCODE_DATA_DIR=/absolute/path/to/isolated/opencode-state
